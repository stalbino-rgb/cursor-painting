{
  "name": "acrylic-mix-guide",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "share:https": "lt --port 5173",
    "share:ssh": "ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -R 80:localhost:5173 nokey@localhost.run",
    "ios:share": "concurrently \"npm run dev:lan\" \"npm run share:https\"",
    "ios:ssh": "concurrently \"npm run dev:lan\" \"npm run share:ssh\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  }
}
